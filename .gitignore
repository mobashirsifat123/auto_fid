# === Logs ===
# Throwaway run/install logs are excluded. Curated result-evidence logs under
# reproduction/results/val/ (the raw backing for the results table) are kept.
logs/
*.log
!reproduction/results/val/*.log

# === Cache ===
.cache/
*.cache

# === Agent runtime droppings (never part of the repo) ===
